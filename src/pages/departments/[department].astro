---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import RoleCard from '../../components/RoleCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getDepartments, getJobsByDepartment, departmentToSlug, sortByNewest } from '../../lib/jobs';
import type { Job } from '../../types/job';

export const prerender = true;

export const getStaticPaths = (async () => {
  const entries = await getCollection('jobs');
  const jobs: Job[] = sortByNewest(
    entries.map((entry) => ({ slug: entry.id, ...entry.data })),
  );
  const departments = getDepartments(jobs);

  return departments.map((department) => ({
    params: { department: departmentToSlug(department) },
    props: {
      department,
      jobs: getJobsByDepartment(jobs, department),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  department: string;
  jobs: Job[];
}

const { department, jobs } = Astro.props;
---

<Layout title={`${department} Roles — Caldova Careers`}>
  <div class="py-8">
    <div class="mb-8">
      <a href="/" class="text-sm text-blue-400 hover:underline">← All open roles</a>
      <h1 class="text-3xl font-bold text-slate-100 mt-4 mb-2" data-testid="department-title">
        {department}
      </h1>
      <p class="text-slate-400">
        Explore open roles in the {department} department at Caldova.
      </p>
    </div>

    {jobs.length === 0 ? (
      <EmptyState text={`No open roles in ${department} right now.`} />
    ) : (
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
        data-testid="roles-grid"
      >
        {jobs.map((job) => <RoleCard job={job} />)}
      </div>
    )}
  </div>
</Layout>

---
interface Props {
    /** Optional message to display in the empty state container. If omitted, slot contents are rendered. */
    text?: string;
}

const { text } = Astro.props;
---

<div
    data-testid="empty-state"
    class="text-center py-12 bg-slate-800/50 backdrop-blur-sm rounded-xl border border-slate-700"
>
    {
        text ? (
            <p data-testid="empty-state-text" class="text-slate-300">
                {text}
            </p>
        ) : (
            <slot />
        )
    }
</div>
